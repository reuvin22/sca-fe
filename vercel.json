{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://sca-web-app.firebaseapp.com/__/auth/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }]
    }
  ]
}
